# 공룡 박물관 AR — 서버 환경변수 예시
# 사용법: 이 파일을 복사해 .env 로 만든 뒤 값을 채운다.
#   cp .env.example .env
# 실제 .env 는 .gitignore 로 커밋에서 제외된다.

# --- PostgreSQL (docker-compose.yml 이 참조) ---
POSTGRES_USER=dino
POSTGRES_PASSWORD=dino_dev_pw
POSTGRES_DB=dino_ar

# --- 앱 접속 문자열 ---
# FastAPI(feature/fastapi-skeleton)가 SQLAlchemy(psycopg2)로 접속할 때 사용.
# host 는 로컬 실행 기준 localhost, 컨테이너 내부에서 붙을 땐 db 로 바꾼다.
DATABASE_URL=postgresql+psycopg2://dino:dino_dev_pw@localhost:5432/dino_ar

# --- AI 도슨트 LLM ---
#   gemini  : Google Gemini API (실제 사용. 무료 티어 있음. LLM_API_KEY 필요)
#   mock    : API 키 없이 동작하는 개발·테스트용 더미 응답
#   failing : 항상 실패 → docent_text 폴백 경로 수동 검증용
LLM_PROVIDER=mock

# !!! 실제 API 키를 이 파일에 넣지 말 것 !!!
# .env.example 은 git 에 커밋된다. 키는 .env 에만 넣는다(.gitignore 대상).
#   cp .env.example .env   후 .env 에서 아래 값을 채운다.
# 키 발급(무료): https://aistudio.google.com/apikey
LLM_API_KEY=

# 실측: 3.6-flash + minimal = 약 1.5초 (2초 KPI 충족)
# gemini-2.5-flash 는 신규 사용자에게 제공되지 않는다(404).
LLM_MODEL=gemini-3.6-flash
# 응답 텍스트 상한
LLM_MAX_TOKENS=2048
# minimal | low | medium | high — low 만 돼도 4초대로 뛰므로 minimal 권장
LLM_THINKING_LEVEL=minimal
# Gemini API 최소 deadline 은 10초. KPI 가 아니라 '응답이 멎었을 때 상한'.
LLM_TIMEOUT_SEC=10.0
